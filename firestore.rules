rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /customers/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid','name','email','phone','phoneVerified','updatedAt'])
        && request.resource.data.keys().hasAll(['uid','name','email','phone','phoneVerified','updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 20
        && request.resource.data.phoneVerified == false
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /inventory/{productId} {
      // Inventory records contain public product status only; writing remains admin-only.
      allow get, list: if true;
      allow create, update: if isAdmin()
        && productId.matches('^[a-z][a-z0-9-]{0,59}$')
        && request.resource.data.keys().hasOnly(['productId','status','updatedAt','updatedBy'])
        && request.resource.data.keys().hasAll(['productId','status','updatedAt','updatedBy'])
        && request.resource.data.productId == productId
        && request.resource.data.status in ['AVAILABLE','COMING_SOON','SOLD_OUT']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    // Separate colour/size availability overrides. No customer or administrator PII.
    match /skuAvailability/{overrideId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['productId','variantId','colour','size','status','updatedAt'])
        && request.resource.data.keys().hasAll(['productId','variantId','colour','size','status','updatedAt'])
        && request.resource.data.productId is string
        && request.resource.data.productId.matches('^[a-z][a-z0-9-]{0,59}$')
        && request.resource.data.variantId is string
        && request.resource.data.variantId.matches('^colour-([1-9]|10)$')
        && request.resource.data.colour is string
        && request.resource.data.colour.size() >= 1
        && request.resource.data.colour.size() <= 100
        && request.resource.data.size in ['ALL','S','M','L','XL','XXL']
        && overrideId == request.resource.data.productId + '--' + request.resource.data.variantId + '--' + request.resource.data.size
        && request.resource.data.status in ['AVAILABLE','COMING_SOON','SOLD_OUT']
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    // Remaining physical pieces are separate from manual status overrides.
    // The published catalogue also clamps counts to its current physical ceiling.
    match /skuRemaining/{remainingId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['productId','variantId','colour','size','remainingQuantity','physicalCeiling','updatedAt'])
        && request.resource.data.keys().hasAll(['productId','variantId','colour','size','remainingQuantity','physicalCeiling','updatedAt'])
        && request.resource.data.productId is string
        && request.resource.data.productId.matches('^[a-z][a-z0-9-]{0,59}$')
        && request.resource.data.variantId is string
        && request.resource.data.variantId.matches('^colour-([1-9]|10)$')
        && request.resource.data.colour is string
        && request.resource.data.colour.size() >= 1
        && request.resource.data.colour.size() <= 100
        && request.resource.data.size in ['S','M','L','XL','XXL']
        && remainingId == request.resource.data.productId + '--' + request.resource.data.variantId + '--' + request.resource.data.size
        && request.resource.data.remainingQuantity is int
        && request.resource.data.physicalCeiling is int
        && request.resource.data.remainingQuantity >= 0
        && request.resource.data.physicalCeiling >= 0
        && request.resource.data.remainingQuantity <= request.resource.data.physicalCeiling
        && request.resource.data.physicalCeiling <= 9007199254740991
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    // Orders and other collections remain locked until a secure backend exists.
    match /{document=**} { allow read, write: if false; }
  }
}
